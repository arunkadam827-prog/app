<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_hero"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/navigate_back"
                android:padding="@dimen/space_xxs"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/edit_profile_title"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_white_glass" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_2xl">

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="sans-serif-medium"
                android:text="@string/full_name_label"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input_field"
                android:hint="@string/full_name_hint"
                android:inputType="textPersonName"
                android:paddingHorizontal="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="sans-serif-medium"
                android:text="@string/email_label"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/edit_email"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input_field"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="sans-serif-medium"
                android:text="@string/phone_label"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/edit_phone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input_field"
                android:hint="@string/phone_hint"
                android:inputType="phone"
                android:paddingHorizontal="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="sans-serif-medium"
                android:text="@string/address_label"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/edit_address"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_input_field"
                android:gravity="top|start"
                android:hint="@string/address_hint"
                android:inputType="textPostalAddress|textMultiLine"
                android:padding="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:fontFamily="sans-serif-medium"
                android:text="@string/city_label"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/edit_city"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginBottom="@dimen/space_2xl"
                android:background="@drawable/bg_input_field"
                android:hint="@string/city_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="@dimen/space_lg"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="15sp" />

            <Button
                android:id="@+id/save_profile_button"
                style="@style/Widget.Farmer.Button.Primary"
                android:layout_width="match_parent"
                android:text="@string/save_profile" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>
