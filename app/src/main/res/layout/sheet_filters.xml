<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/space_xl">

    <!-- Grab handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_md"
        android:background="@color/border" />

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/filters"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sheet_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_primary_soft"
            android:clickable="true"
            android:contentDescription="@string/clear_all"
            android:focusable="true"
            android:padding="@dimen/space_xs"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Sourcing -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="Sourcing"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/sheet_sourcing_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="@dimen/space_sm"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_source_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="All Products"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_source_farm"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="🌱 Direct from Farm"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/filter_category"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="@dimen/space_sm"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_cat_all"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="@string/categories_all"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_cat_vegetables"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_vegetables"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_cat_fruits"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_fruits"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_cat_grains"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/category_grains"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

        <com.google.android.material.chip.Chip
            android:id="@+id/sheet_cat_others"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/filter_others"
            android:textColor="@color/selector_chip_text"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/selector_chip_bg"
            app:chipCornerRadius="@dimen/radius_pill" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Price range -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/filter_price_range"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sheet_min_price_layout"
            style="@style/Widget.Farmer.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:hint="@string/filter_min_price">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sheet_min_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/sheet_max_price_layout"
            style="@style/Widget.Farmer.TextField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/filter_max_price">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/sheet_max_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Sort -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_sm"
        android:text="@string/filter_sort_by"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/sheet_sort_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/sheet_sort_relevance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/sort_relevance"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sheet_sort_price_low"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_price_low_high"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/sheet_sort_price_high"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_price_high_low"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_reset"
            style="@style/Widget.Farmer.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/reset" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_apply"
            style="@style/Widget.Farmer.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1.4"
            android:text="@string/apply_filters" />
    </LinearLayout>

</LinearLayout>
