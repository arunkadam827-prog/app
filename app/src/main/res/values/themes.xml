<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =========================================================
         Farmer+  •  New-gen Material 3 theme
         ========================================================= -->

    <style name="Base.Theme.farmer" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Typography defaults -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>

        <!-- Widget defaults -->
        <item name="materialButtonStyle">@style/Widget.Farmer.Button.Primary</item>
        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Filter</item>
        <item name="bottomNavigationStyle">@style/Widget.Farmer.BottomNav</item>
    </style>

    <style name="Theme.farmer" parent="Base.Theme.farmer">
    </style>

    <!-- Bottom navigation styling -->
    <style name="Widget.Farmer.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@null</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

</resources>
