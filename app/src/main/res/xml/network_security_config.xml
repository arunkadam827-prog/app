<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (http) traffic to any address. Required because the
         backend runs on a local PC reached over LAN via http://<PC_IP>:8080.
         For production, host the backend behind https and remove this. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
