<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.farmer"
        android:usesCleartextTraffic="true">


        <!-- Main / Launcher Activity -->
        <activity
            android:exported="true"
            android:name=".activities.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Activities -->
        <activity
            android:exported="false"
            android:name=".activities.MainActivity" />

        <activity
            android:exported="false"
            android:name=".activities.RegistrationActivity" />

        <!-- Dashboard & Product Management Activities -->
        <activity
            android:exported="false"
            android:name=".activities.FarmerDashboardActivity" />

        <activity
            android:exported="false"
            android:name=".activities.AddProductActivity" />

        <activity
            android:exported="false"
            android:name=".activities.ProductDetailActivity" />

        <activity
            android:exported="false"
            android:name=".activities.ProductListActivity" />

        <!-- Orders Activity -->
        <activity
            android:exported="false"
            android:name=".activities.OrdersActivity" />
        <activity
            android:exported="false"
            android:name=".activities.EditProfileActivity" />
        <activity
            android:exported="false"
            android:name=".activities.settingsActivity" />

        <activity
            android:exported="false"
            android:name=".activities.HelpSupportActivity" />
        <activity
            android:exported="false"
            android:name=".activities.CheckoutActivity" />
    </application>

</manifest>